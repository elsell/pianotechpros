PIANOTECHPROS_HTTP_ADDR=:8080
PIANOTECHPROS_PUBLIC_BASE_URL=http://localhost:8080
PIANOTECHPROS_DATABASE_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
PIANOTECHPROS_AUDIT_EVENTS_PER_MINUTE=120
PIANOTECHPROS_AUDIT_LIMITER_PRINCIPALS=10000
PIANOTECHPROS_AUDIT_RETENTION_DSN=postgres://app_audit_retention:app_audit_retention@localhost:5432/app?sslmode=disable
PIANOTECHPROS_AUDIT_RETENTION_DAYS=365
PIANOTECHPROS_AUDIT_RETENTION_BATCH_SIZE=1000
PIANOTECHPROS_AUDIT_RETENTION_DRY_RUN=true
PIANOTECHPROS_SCALAR_DOCS_DISABLED=false
PIANOTECHPROS_SESSION_TTL_MINUTES=60
PIANOTECHPROS_SESSION_ABSOLUTE_TTL_MINUTES=720
PIANOTECHPROS_ACCOUNT_PROVISIONING_MODE=open
PIANOTECHPROS_ACCOUNT_INVITED_EMAILS=
PIANOTECHPROS_INVITATION_ADMIN_IDENTITIES=
PIANOTECHPROS_ACCOUNT_SELF_DEACTIVATION_ENABLED=true
PIANOTECHPROS_AUTHORIZATION_MAX_ATTEMPTS=5
PIANOTECHPROS_REQUESTS_PER_MINUTE=300
PIANOTECHPROS_REQUEST_LIMITER_SOURCES=10000
PIANOTECHPROS_TRUSTED_PROXY_CIDRS=
PIANOTECHPROS_DATABASE_MAX_OPEN_CONNS=25
PIANOTECHPROS_DATABASE_MAX_IDLE_CONNS=10
PIANOTECHPROS_DATABASE_CONN_MAX_LIFETIME_SECONDS=1800
PIANOTECHPROS_DATABASE_CONN_MAX_IDLE_SECONDS=300
PIANOTECHPROS_DATABASE_INSECURE=true
PIANOTECHPROS_CURSOR_SIGNING_KEY=local-development-cursor-signing-key-change-me
PIANOTECHPROS_METRICS_BEARER_TOKEN=local-development-metrics-token-change-me
PIANOTECHPROS_OTEL_EXPORTER_OTLP_ENDPOINT=
PIANOTECHPROS_OTEL_EXPORTER_OTLP_INSECURE=false
PIANOTECHPROS_OTEL_SERVICE_NAME=pianotechpros-api
PIANOTECHPROS_OIDC_ISSUER=http://localhost:5556/dex
PIANOTECHPROS_OIDC_BACKCHANNEL_URL=
PIANOTECHPROS_OIDC_AUDIENCES=pianotechpros-web,pianotechpros-mobile,pianotechpros-docs
PIANOTECHPROS_OIDC_DOCS_CLIENT_ID=pianotechpros-docs
PIANOTECHPROS_OIDC_DOCS_REDIRECT_URI=http://localhost:8080/docs
PIANOTECHPROS_OIDC_INSECURE=true
PIANOTECHPROS_CORS_ALLOWED_ORIGINS=http://localhost:5173
PIANOTECHPROS_SPICEDB_ENDPOINT=localhost:50051
PIANOTECHPROS_SPICEDB_TOKEN=
PIANOTECHPROS_SPICEDB_SCHEMA_TOKEN=
PIANOTECHPROS_SPICEDB_INSECURE=true
PIANOTECHPROS_APP_ENV=development
PIANOTECHPROS_API_URL=http://localhost:8080
# Optional private server-side API address; Compose sets its service URL.
# PIANOTECHPROS_SERVER_API_URL=https://api.example.com
PIANOTECHPROS_WEB_OIDC_CLIENT_ID=pianotechpros-web
PIANOTECHPROS_MOBILE_OIDC_CLIENT_ID=pianotechpros-mobile

# Explicit local development inquiry policy. Enable Turnstile for deployment.
PIANOTECHPROS_INQUIRY_CHALLENGE_POLICY=disabled
PIANOTECHPROS_TURNSTILE_SITE_KEY=
PIANOTECHPROS_TURNSTILE_SECRET=
PIANOTECHPROS_TURNSTILE_HOSTNAME=

# Optional voice processing: configure all three server-only values together.
PIANOTECHPROS_GEMINI_API_KEY=
PIANOTECHPROS_VOICE_TRANSCRIPTION_MODEL=
PIANOTECHPROS_VOICE_EXTRACTION_MODEL=

# Optional discovery origin; configure the new public HTTPS hostname before launch.
# PIANOTECHPROS_PUBLIC_WEB_ORIGIN=https://pianos.example
