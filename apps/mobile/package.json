{
  "name": "@pianotechpros/mobile",
  "private": true,
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "mobile:doctor": "expo-doctor",
    "mobile:compat": "expo install --check && node ../../scripts/validate-expo-native-set.mjs",
    "mobile:export": "expo export --platform ios --output-dir dist/ios && expo export --platform android --output-dir dist/android",
    "mobile:prebuild": "node ../../scripts/validate-mobile-config.mjs && expo prebuild --clean --no-install && python3 ../../scripts/check-mobile-photo-permissions.py",
    "mobile:build:android": "pnpm mobile:prebuild && cd android && ./gradlew assembleDebug",
    "mobile:build:ios": "pnpm mobile:prebuild && bundle install --jobs 4 --retry 3 && cd ios && bundle exec pod install && cd ../../.. && ./scripts/build-ios-simulator.sh",
    "mobile:dev:android": "PIANOTECHPROS_APP_ENV=development expo run:android",
    "mobile:dev:ios": "PIANOTECHPROS_APP_ENV=development expo run:ios",
    "mobile:release:android": "PIANOTECHPROS_APP_ENV=production node ../../scripts/validate-mobile-release-env.mjs && node ../../scripts/run-eas.mjs android",
    "mobile:release:ios": "PIANOTECHPROS_APP_ENV=production node ../../scripts/validate-mobile-release-env.mjs && node ../../scripts/run-eas.mjs ios",
    "build": "pnpm mobile:export",
    "check": "tsc --noEmit",
    "test": "tsx --test src/native-intent.test.ts src/i18n.test.ts src/inventory/photo-cache-path.test.ts src/inventory/voice-cache-path.test.ts src/inventory/voice-failure.test.ts src/inventory/photo-render-scope.test.ts src/provider-auth-state.test.ts src/session-restoration.test.ts src/session-establishment.test.ts src/session-lifecycle.test.ts ../../scripts/mobile-recovery-database.test.ts ../../scripts/mobile-photo-config.test.ts && node --test ../../scripts/run-eas.test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "55.0.12",
    "@pianotechpros/api-client": "workspace:*",
    "@pianotechpros/client-core": "workspace:*",
    "@pianotechpros/i18n": "workspace:*",
    "@react-navigation/native": "^7.1.33",
    "expo": "55.0.32",
    "expo-asset": "55.0.20",
    "expo-audio": "55.0.18",
    "expo-auth-session": "55.0.19",
    "expo-constants": "55.0.17",
    "expo-crypto": "55.0.19",
    "expo-dev-client": "55.0.41",
    "expo-file-system": "55.0.26",
    "expo-image-manipulator": "55.0.21",
    "expo-image-picker": "55.0.24",
    "expo-linking": "55.0.17",
    "expo-localization": "55.0.19",
    "expo-router": "55.0.18",
    "expo-secure-store": "55.0.18",
    "expo-sqlite": "55.0.20",
    "expo-system-ui": "55.0.22",
    "expo-updates": "55.0.33",
    "expo-web-browser": "55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.1",
    "@types/react": "19.2.17",
    "expo-doctor": "1.20.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
